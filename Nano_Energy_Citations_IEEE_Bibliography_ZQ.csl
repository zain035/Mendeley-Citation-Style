<?xml version="1.0" encoding="UTF-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl"
       version="1.0"
       class="in-text"
       default-locale="en-US">

  <info>
    <title>Nano Energy Citations + IEEE Bibliography ZQ</title>
    <id>http://www.zotero.org/styles/nano-energy-ieee-zq-v4</id>
    <link href="http://www.zotero.org/styles/nano-energy-ieee-zq-v4" rel="self"/>
    <author>
      <name>Custom style prepared for ZQ</name>
    </author>
    <category citation-format="numeric"/>
    <category field="engineering"/>
    <summary>Square bracket citations with collapsed numerical ranges and IEEE-inspired bibliography.</summary>
    <updated>2026-11-13T00:00:00+00:00</updated>
  </info>

  <!-- AUTHORS -->
  <macro name="author">
    <names variable="author">
      <name initialize-with=". "
            delimiter=", "
            and="text"
            delimiter-precedes-last="always"/>
      <et-al/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <!-- ARTICLE TITLE -->
  <macro name="article-title">
    <text variable="title" quotes="true"/>
  </macro>

  <!-- JOURNAL TITLE -->
  <macro name="journal-title">
    <text variable="container-title" font-style="italic"/>
  </macro>

  <!-- VOLUME AND ISSUE -->
  <macro name="volume-issue">
    <group delimiter=", ">
      <text variable="volume" prefix="vol. "/>
      <text variable="issue" prefix="no. "/>
    </group>
  </macro>

  <!-- PAGES OR ARTICLE NUMBER -->
  <macro name="pages-or-number">
    <choose>
      <if variable="page">
        <text variable="page" prefix="pp. "/>
      </if>
      <else-if variable="number">
        <text variable="number" prefix="Art. no. "/>
      </else-if>
    </choose>
  </macro>

  <!-- PUBLICATION YEAR -->
  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <!-- DOI -->
  <macro name="doi">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="doi: "/>
      </if>
    </choose>
  </macro>

  <!-- IN-TEXT CITATIONS -->
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <!-- IEEE-INSPIRED BIBLIOGRAPHY -->
  <bibliography et-al-min="7"
                et-al-use-first="6"
                second-field-align="flush">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout>
      <text variable="citation-number" prefix="[" suffix="] "/>
      <text macro="author" suffix=", "/>
      <choose>
        <if type="article-journal">
          <group delimiter=", ">
            <text macro="article-title"/>
            <text macro="journal-title"/>
            <text macro="volume-issue"/>
            <text macro="pages-or-number"/>
            <text macro="year"/>
          </group>
          <text value="."/>
          <text macro="doi" prefix=" "/>
          <text value="."/>
        </if>
        <else>
          <group delimiter=", ">
            <text variable="title"/>
            <text variable="container-title" font-style="italic"/>
            <text macro="year"/>
          </group>
          <text value="."/>
          <text macro="doi" prefix=" "/>
          <text value="."/>
        </else>
      </choose>
    </layout>
  </bibliography>

</style>
