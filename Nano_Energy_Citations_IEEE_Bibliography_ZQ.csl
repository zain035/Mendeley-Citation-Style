<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>Nano Energy + IEEE ZQ</title>
    <id>http://www.zotero.org/styles/nano-energy-ieee-zq</id>
    <link href="http://www.zotero.org/styles/nano-energy-ieee-zq" rel="self"/>
    <author><name>Custom style prepared for ZQ</name></author>
    <category citation-format="numeric"/>
    <category field="engineering"/>
    <summary>Square bracket citations with IEEE-inspired bibliography.</summary>
    <updated>2026-11-13T00:00:00+00:00</updated>
  </info>

  <macro name="author">
    <names variable="author">
      <name and="text" initialize-with=". "/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="article-title">
    <text variable="title" quotes="true"/>
  </macro>

  <macro name="journal-title">
    <text variable="container-title" font-style="italic"/>
  </macro>

  <macro name="volume-and-issue">
    <group delimiter=", ">
      <text variable="volume" prefix="vol. "/>
      <text variable="issue" prefix="no. "/>
    </group>
  </macro>

  <macro name="page-or-article-number">
    <choose>
      <if variable="page">
        <text variable="page" prefix="pp. "/>
      </if>
      <else-if variable="number">
        <text variable="number" prefix="Art. no. "/>
      </else-if>
    </choose>
  </macro>

  <macro name="publication-year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="doi">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="doi: "/>
      </if>
    </choose>
  </macro>

  <citation>
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
 <citation collapse="citation-number">
  <sort>
    <key variable="citation-number"/>
  </sort>
  <layout prefix="[" suffix="]" delimiter=", ">
    <text variable="citation-number"/>
  </layout>
</citation>

  <bibliography second-field-align="flush">
    <layout>
      <text variable="citation-number" prefix="[" suffix="] "/>
      <text macro="author" suffix=", "/>
      <choose>
        <if type="article-journal">
          <group delimiter=", ">
            <text macro="article-title"/>
            <text macro="journal-title"/>
            <text macro="volume-and-issue"/>
            <text macro="page-or-article-number"/>
            <text macro="publication-year"/>
          </group>
          <text value="."/>
          <text macro="doi" prefix=" "/>
          <text value="."/>
        </if>
        <else>
          <group delimiter=", ">
            <text variable="title"/>
            <text variable="container-title" font-style="italic"/>
            <text macro="publication-year"/>
          </group>
          <text value="."/>
          <text macro="doi" prefix=" "/>
          <text value="."/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
